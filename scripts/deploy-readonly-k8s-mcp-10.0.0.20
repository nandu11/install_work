#!/usr/bin/env bash
set -euo pipefail

TARGET_HOST="${TARGET_HOST:-10.0.0.20}"
TARGET_USER="${TARGET_USER:-root}"
TARGET="${TARGET_USER}@${TARGET_HOST}"
REMOTE_DIR="${REMOTE_DIR:-/opt/readonly-k8s-mcp}"
SERVICE_NAME="readonly-k8s-mcp"

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP_DIR="$(mktemp -d)"
cleanup() {
  rm -rf "${TMP_DIR}"
}
trap cleanup EXIT

if [[ -n "${READONLY_K8S_MCP_TOKEN:-}" ]]; then
  TOKEN="${READONLY_K8S_MCP_TOKEN}"
  if [[ "${TOKEN}" == *\"* || "${TOKEN}" == *\\* || "${TOKEN}" == *$'\n'* || "${TOKEN}" == *$'\r'* ]]; then
    echo "READONLY_K8S_MCP_TOKEN contains characters this simple JSON template script cannot safely embed." >&2
    exit 1
  fi
  GENERATED_TOKEN="false"
else
  if command -v openssl >/dev/null 2>&1; then
    TOKEN="$(openssl rand -hex 32)"
  else
    TOKEN="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
  fi
  GENERATED_TOKEN="true"
fi

export GOCACHE="${GOCACHE:-/tmp/readonly-k8s-mcp-go-cache}"
go test ./...
go build -buildvcs=false -o "${TMP_DIR}/readonly-k8s-mcp" ./cmd/readonly-k8s-mcp

sed "s/CHANGE_ME/${TOKEN}/g" \
  "${ROOT_DIR}/release/intranet-deploy/config.k8s-cluster-example.json" \
  > "${TMP_DIR}/config.json"
cp "${ROOT_DIR}/release/intranet-deploy/readonly-k8s-mcp.service" "${TMP_DIR}/readonly-k8s-mcp.service"

ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "${TARGET}" \
  "useradd --system --home-dir /nonexistent --shell /usr/sbin/nologin ${SERVICE_NAME} 2>/dev/null || true; \
   install -d -m 0750 -o root -g ${SERVICE_NAME} ${REMOTE_DIR}; \
   install -d -m 0750 -o ${SERVICE_NAME} -g ${SERVICE_NAME} ${REMOTE_DIR}/logs; \
   install -d -m 0755 /etc/systemd/system"

scp "${TMP_DIR}/readonly-k8s-mcp" "${TARGET}:/tmp/readonly-k8s-mcp"
scp "${TMP_DIR}/config.json" "${TARGET}:/tmp/readonly-k8s-mcp.config.json"
scp "${TMP_DIR}/readonly-k8s-mcp.service" "${TARGET}:/tmp/readonly-k8s-mcp.service"

ssh -o BatchMode=yes "${TARGET}" \
  "install -m 0755 -o root -g root /tmp/readonly-k8s-mcp ${REMOTE_DIR}/readonly-k8s-mcp; \
   install -m 0640 -o root -g ${SERVICE_NAME} /tmp/readonly-k8s-mcp.config.json ${REMOTE_DIR}/config.json; \
   install -m 0644 -o root -g root /tmp/readonly-k8s-mcp.service /etc/systemd/system/readonly-k8s-mcp.service; \
   rm -f /tmp/readonly-k8s-mcp /tmp/readonly-k8s-mcp.config.json /tmp/readonly-k8s-mcp.service; \
   systemctl daemon-reload; \
   systemctl enable --now ${SERVICE_NAME}; \
   systemctl restart ${SERVICE_NAME}; \
   systemctl --no-pager --full status ${SERVICE_NAME}; \
   ss -ltnp | grep ':8787' || true; \
   for f in kubeconfig id_ed25519 known_hosts; do test -e ${REMOTE_DIR}/\$f || echo WARN missing ${REMOTE_DIR}/\$f; done"

curl -fsS "http://${TARGET_HOST}:8787/healthz"
echo

UNAUTH_CODE="$(curl -sS -o /dev/null -w '%{http_code}' \
  -X POST \
  -H 'Content-Type: application/json' \
  -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}' \
  "http://${TARGET_HOST}:8787/mcp")"
test "${UNAUTH_CODE}" = "401"

curl -fsS \
  -X POST \
  -H "Authorization: Bearer ${TOKEN}" \
  -H 'Content-Type: application/json' \
  -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}' \
  "http://${TARGET_HOST}:8787/mcp"
echo

curl -fsS \
  -X POST \
  -H "Authorization: Bearer ${TOKEN}" \
  -H 'Content-Type: application/json' \
  -d '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}' \
  "http://${TARGET_HOST}:8787/mcp"
echo

if [[ "${GENERATED_TOKEN}" == "true" ]]; then
  echo "Generated READONLY_K8S_MCP_TOKEN for this deployment:"
  echo "${TOKEN}"
fi
